        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nenum EstadoOrden {\n    PENDIENTE\n    ASIGNADA\n    EN_ATENCION\n    COMPLETADA\n    CANCELADA\n}\n\nenum EstadoJornada {\n    EN_PREPARACION\n    EN_ATENCION\n    CERRADA\n}\n\nabstract class OrdenServicio {\n    # String codigo\n    # String cliente\n    # String direccion\n    # double horasEstimadas\n    # String zona\n    # EstadoOrden estado\n    # int visitasRealizadas\n    + OrdenServicio(String, String, String, double, String)\n    {abstract} + double calcularCosto()\n    {abstract} + int getTiempoAtencionDias()\n    {abstract} + int getLimiteVisitas()\n    {abstract} + boolean requiereCertificacionRefrigeracion()\n    + String getCodigo()\n    + EstadoOrden getEstado()\n    + void setEstado(EstadoOrden)\n    + int getVisitasRealizadas()\n    + void incrementarVisitas()\n    + double getHorasEstimadas()\n    + String getZona()\n    + String getCategoriaNombre()\n}\n\nclass Diagnostico {\n    + Diagnostico(String, String, String, double, String)\n    + double calcularCosto()\n    + int getTiempoAtencionDias()\n    + int getLimiteVisitas()\n    + boolean requiereCertificacionRefrigeracion()\n}\n\nclass Instalacion {\n    # int puntos\n    + Instalacion(String, String, String, double, String, int)\n    + double calcularCosto()\n    + int getTiempoAtencionDias()\n    + int getLimiteVisitas()\n    + boolean requiereCertificacionRefrigeracion()\n}\n\nclass InstalacionElectricaCertificada {\n    - double valorMateriales\n    + InstalacionElectricaCertificada(String, String, String, double, String, int, double)\n    + double calcularCosto()\n    + int getTiempoAtencionDias()\n    + int getLimiteVisitas()\n}\n\nclass MantenimientoAireAcondicionado {\n    - int btu\n    + MantenimientoAireAcondicionado(String, String, String, double, String, int)\n    + double calcularCosto()\n    + int getTiempoAtencionDias()\n    + int getLimiteVisitas()\n    + boolean requiereCertificacionRefrigeracion()\n}\n\nclass Cuadrilla {\n    - String codigo\n    - double capacidadHoras\n    - boolean certificadaRefrigeracion\n    - boolean ocupada\n    + Cuadrilla(String, double, boolean)\n    + String getCodigo()\n    + double getCapacidadHoras()\n    + boolean isCertificadaRefrigeracion()\n    + boolean isOcupada()\n    + void setOcupada(boolean)\n}\n\nclass Jornada {\n    - Cuadrilla cuadrilla\n    - List&lt;OrdenServicio&gt; ordenesAsignadas\n    - EstadoJornada estado\n    + Jornada(Cuadrilla)\n    + void asignarOrden(OrdenServicio)\n    + void retirarOrden(OrdenServicio)\n    + void iniciarJornada(GestorIngresos)\n    + void registrarResultadoOrden(String, boolean, GestorIngresos)\n    + EstadoJornada getEstado()\n    + Cuadrilla getCuadrilla()\n    + List&lt;OrdenServicio&gt; getOrdenesAsignadas()\n    + double getCapacidadDisponible()\n}\n\nclass GestorIngresos {\n    - double ingresoRegistro\n    - double ingresoVisitasAdicionales\n    - Map&lt;String, Double&gt; ingresosPorCategoria\n    + void registrarIngresoRegistro(String, double)\n    + void registrarIngresoVisitasAdicionales(double)\n    + double getIngresoRegistro()\n    + double getIngresoVisitasAdicionales()\n    + Map&lt;String, Double&gt; getIngresosPorCategoria()\n}\n\nclass SistemaTecniHogar {\n    + {static} void main(String[] args)\n}\n\nOrdenServicio &lt;|-- Diagnostico\nOrdenServicio &lt;|-- Instalacion\nInstalacion &lt;|-- InstalacionElectricaCertificada\nOrdenServicio &lt;|-- MantenimientoAireAcondicionado\n\nJornada \&quot;1\&quot; o-- \&quot;1\&quot; Cuadrilla : contiene\nJornada \&quot;1\&quot; o-- \&quot;*\&quot; OrdenServicio : gestiona/asigna\nSistemaTecniHogar ..&gt; OrdenServicio : usa\nSistemaTecniHogar ..&gt; Cuadrilla : usa\nSistemaTecniHogar ..&gt; Jornada : usa\nSistemaTecniHogar ..&gt; GestorIngresos : usa\nJornada ..&gt; GestorIngresos : actualiza\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fP-CgEP3EyNYD2w0sno_-3">
